# Copy to .env next to the compose file you use. Every line is optional.
# STRATA_IMAGE=strata:0.2.3-cuda13     # only to use an image you built yourself (docker/build.sh); the default is the published ghcr.io/niko1221/strata image
# MODEL=IQ3_XXS
# MODEL_PATH=/models                        # with a volume line  - /srv/gguf/IQ3_XXS:/models:ro
# CONTEXT=32k
# PARALLEL=2
# VISION=off
# TUNE=skip
# API_KEY=put-a-long-random-key-here        # openssl rand -hex 24
# STRATA_BIND=127.0.0.1                     # 0.0.0.0 = reachable from your network (then use a real API_KEY)
# STRATA_PORT=8080
# RENDER_GID=                               # AMD / Intel only: getent group render | cut -d: -f3
